{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window. Process creation stays in the Rust backend; the frontend can only call the explicitly listed commands.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "allow-app-info",
    "allow-app-log",
    "allow-wsl-detect",
    "allow-wsl-start-distro",
    "allow-wsl-terminate-distro",
    "allow-wsl-linux-home",
    "allow-wsl-to-linux-path",
    "allow-env-diagnostics",
    "allow-terminal-open",
    "allow-terminal-write",
    "allow-terminal-write-bytes",
    "allow-terminal-resize",
    "allow-terminal-ack",
    "allow-terminal-close",
    "allow-terminal-busy-check",
    "allow-terminal-list",
    "allow-fs-resolve-location",
    "allow-fs-list-dir",
    "allow-fs-browse-dirs",
    "allow-fs-create",
    "allow-fs-rename",
    "allow-fs-delete",
    "allow-project-templates",
    "allow-project-create",
    "allow-settings-load",
    "allow-settings-save",
    "allow-settings-reset",
    "allow-state-load",
    "allow-state-save",
    "allow-monitor-sample-host",
    "allow-monitor-sample-wsl"
  ]
}
